rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config: readable by any authenticated user
    match /config/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // server-side only
    }

    // Companies: authenticated users can read and create
    match /companies/{companyId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false; // server-side only
    }

    // Users: only the user themselves can read/write their doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Jobs: read/write if authenticated (server-side enforcement is primary)
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;

      // Forms subcollection
      match /forms/{formId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
